{
  "@context": [
    "https://schema.org",
    {
      "acp": "https://acp.schema.org"
    }
  ],

  "@type": "acp:Registry",

  "registryName": "ACP Travel Registry",
  "registryId": "acp.travel.registry",
  "description": "Federated registry of ACP hotel connectors including sandbox and production environments.",

  "version": "1.1.0",
  "updated": "2025-11-04T00:00:00Z",

  "publisher": {
    "@type": "Organization",
    "name": "Your Company Name",
    "url": "https://yourdomain.com",
    "contactEmail": "support@yourdomain.com"
  },

  "trust": {
    "verifiedBy": "self",
    "integrity": "unsigned",
    "uptime": "unknown",
    "sla": "none"
  },

  "connectors": [

    {
      "name": "ACP Hotel Finder",
      "connectorId": "acp.hotelbeds.provider.prod",
      "description": "Hotel availability and booking using Hotelbeds production inventory.",

      "manifestUrl": "https://nachofree.github.io/acp-manifest/manifest.json",
      "schemaVersion": "1.0",

      "environment": "production",
      "sandbox": false,

      "categories": ["travel", "hotels", "lodging", "availability", "booking"],
      "regions": ["ES", "US", "MX", "EU"],
      "languages": ["en", "es"],

      "capabilities": {
        "availability": true,
        "checkout": true
      },

      "provenance": {
        "source": "Hotelbeds",
        "integrationType": "wholesale",
        "sandbox": false
      }
    },

    {
      "name": "ACP Hotel Finder (Sandbox)",
      "connectorId": "acp.hotelbeds.provider.sandbox",
      "description": "Hotel availability and booking in the Hotelbeds sandbox environment (test data only).",

      "manifestUrl": "https://nachofree.github.io/acp-manifest/manifest.json",
      "schemaVersion": "1.0",

      "environment": "sandbox",
      "sandbox": true,

      "categories": ["travel", "hotels", "lodging", "availability", "booking"],
      "regions": ["ES", "US", "MX", "EU"],
      "languages": ["en", "es"],

      "capabilities": {
        "availability": true,
        "checkout": true
      },

      "provenance": {
        "source": "Hotelbeds",
        "integrationType": "wholesale",
        "sandbox": true
      }
    },

    {
      "name": "All-Inclusive Resort Registry",
      "connectorId": "acp.allinclusive.registry.prod",
      "description": "Curated feed of verified all-inclusive resorts with production booking capabilities.",

      "manifestUrl": "https://acp.yourdomain.com/allinclusive/manifest.json",
      "schemaVersion": "1.0",

      "environment": "production",
      "sandbox": false,

      "categories": ["travel", "resorts", "all-inclusive", "bundles"],
      "regions": ["Caribbean", "MX", "ES", "Mediterranean"],
      "languages": ["en"],

      "capabilities": {
        "availability": true,
        "checkout": true
      },

      "provenance": {
        "source": "Hotelbeds + Direct Partners",
        "integrationType": "curated",
        "sandbox": false
      }
    },

    {
      "name": "All-Inclusive Resort Registry (Sandbox)",
      "connectorId": "acp.allinclusive.registry.sandbox",
      "description": "Test-only version of the All-Inclusive resort registry, using sandbox inventory.",

      "manifestUrl": "https://acp.yourdomain.com/allinclusive/manifest.sandbox.json",
      "schemaVersion": "1.0",

      "environment": "sandbox",
      "sandbox": true,

      "categories": ["travel", "resorts", "all-inclusive", "bundles"],
      "regions": ["Caribbean", "MX", "ES", "Mediterranean"],
      "languages": ["en"],

      "capabilities": {
        "availability": true,
        "checkout": true
      },

      "provenance": {
        "source": "Hotelbeds + Direct Partners",
        "integrationType": "curated",
        "sandbox": true
      }
    }
  ]
