{
  "schema_version": "1.0",
  "name_for_human": "Hotel Feed Service",
  "name_for_agent": "hotel_feed_service",
  "description_for_human": "Provides normalized hotel listings, detailed content, availability, checkout, and full reservation lifecycle.",
  "description_for_agent": "Use `/hotels/feed` for listings, `/hotels/{hotel_id}/details` for content, `/availability/search` for rateKeys, `/checkout/create` to confirm bookings, and reservation endpoints for lifecycle operations.",
  
  "auth": {
    "type": "user_http",
    "authorization_type": "bearer",
    "verification_tokens": {
      "openai": "REPLACE_WITH_YOUR_VERIFICATION_TOKEN"
    }
  },

  "api": {
    "type": "openapi",
    "url": "https://nachofree.github.io/acp-manifest/openapi.yaml"
  },

  "contact_email": "support@yourdomain.com",
  "legal_info_url": "https://around-pulling-silent-reaches.trycloudflare.com/terms",

  "capabilities": {
    "commerce": {
      "type": "feed",
      "resource": "hotel",
      "endpoints": {
        "feed": "/hotels/feed",
        "details": "/hotels/{hotel_id}/details",
        "availability": "/availability/search",
        "checkout": "/checkout/create",
        "get": "/reservation/get",
        "modify": "/reservation/modify",
        "cancel": "/reservation/cancel"
      },
      "lifecycle": {
        "retrieval": true,
        "modification": true,
        "cancellation": true
      }
    }
  },

  "tools": [
    {
      "name": "get_reservation",
      "description": "Retrieve an existing reservation using the booking reference returned during checkout.",
      "input_schema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "description": "Booking reference returned from /checkout/create."
          },
          "refreshFromSupplier": {
            "type": "boolean",
            "default": true,
            "description": "If true, refreshes state from Hotelbeds before returning."
          }
        },
        "required": ["reference"]
      },
      "openapi": {
        "path": "/reservation/get",
        "method": "post"
      }
    },
    {
      "name": "cancel_reservation",
      "description": "Cancel an existing reservation or preview the penalty/refund in dry-run mode.",
      "input_schema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "description": "Booking reference returned from /checkout/create."
          },
          "dryRun": {
            "type": "boolean",
            "default": false,
            "description": "If true, returns a penalty quote without cancelling."
          }
        },
        "required": ["reference"]
      },
      "openapi": {
        "path": "/reservation/cancel",
        "method": "post"
      }
    },
    {
      "name": "modify_reservation",
      "description": "Modify an existing reservation by rebooking new dates (supports dry-run mode).",
      "input_schema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "description": "Booking reference to modify."
          },
          "checkIn": {
            "type": "string",
            "description": "New check-in date (YYYY-MM-DD)."
          },
          "checkOut": {
            "type": "string",
            "description": "New check-out date (YYYY-MM-DD)."
          },
          "dryRun": {
            "type": "boolean",
            "default": false,
            "description": "If true, returns price difference without rebooking."
          }
        },
        "required": ["reference", "checkIn", "checkOut"]
      },
      "openapi": {
        "path": "/reservation/modify",
        "method": "post"
      }
    }
  ],

  "metadata": {
    "version": "2025-10-24",
    "base_url": "https://around-pulling-silent-reaches.trycloudflare.com/",
    "keywords": [
      "hotel",
      "travel",
      "booking",
      "commerce",
      "feed",
      "checkout",
      "acp",
      "agent",
      "normalized-schema",
      "structured-feed",
      "api-registry",
      "openapi",
      "ai-integration",
      "semantic-commerce",
      "llm-plugin",
      "hotelbeds",
      "lodging",
      "hospitality"
    ]
  }
}
